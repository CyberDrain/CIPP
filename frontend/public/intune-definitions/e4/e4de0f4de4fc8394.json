{"id":"ade_accountsettings_primaryaccountname","displayName":"Primary account name","description":"The account name for the account. Setup Assistant will use this value to prefill the Account Name field if 'Prefill account info' is set to 'Not configured'. This field is to be defaulted to the variable, {{partialupn}}, for example, 'John'. For macOS ADE enrollment policies without user device affinity, we recommend configuring {{serialNumber}} as the unique identifier of userless devices.","helpText":null,"infoUrls":[],"categoryId":"6c217eb1-e939-4a7d-8a27-da4b6dbf9513","categoryName":null,"options":null,"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","valueDefinition":{"@odata.type":"#microsoft.graph.deviceManagementConfigurationStringSettingValueDefinition","format":"none","inputValidationSchema":"^[^!@#$%^&*()<>?+=:\"|,]+$","maximumLength":255,"minimumLength":1,"isSecret":false,"fileTypes":[]},"defaultOptionId":null,"applicability":{"description":null,"platform":"macOS","deviceMode":"none","technologies":"enrollment"},"accessTypes":"add,delete,get,replace","settingUsage":"configuration","visibility":"template","rootDefinitionId":"ade_macos_awaitconfiguration","childIds":null,"minimumCount":null,"maximumCount":null,"keywords":["ADE profile","enrollment","Account settings"],"dependentOn":[{"dependentOn":"ade_accountsettings_prefillaccountinfo_1","parentSettingId":"ade_accountsettings_prefillaccountinfo"}],"dependedOnBy":[]}