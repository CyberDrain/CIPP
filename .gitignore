# OS files
Thumbs.db
.DS_Store

# IDE / editor
.vs/
.copilot-memory/
*.user
*.suo

# Logs
*.log

# Local settings (contains secrets)
.env
build/tools/local.settings.json

# Runtime-generated files
_startup.ps1
_http_bundle.ps1
_cache/

# Local dev: ModuleBuilder-compiled CIPP modules overlaid into the dev container
build/.devmodules/
# Local dev: writable .psd1 copies the container rewrites instead of the tracked manifests
build/.devmanifests/
# Local dev: exported Proxyman CA + combined trust bundle (machine-local); build/.env
# activates the optional CA mounts in the compose files. All written by Export-ProxymanCert.ps1.
build/config/proxyman-ca.pem
build/config/proxyman-ca-bundle.pem
build/.env
# Build-generated Get-Help cache (build-function-parameters.ps1)
backend/Config/function-parameters.json*
localfiles/

graphify-out/
graphify/
.claude/
CLAUDE.md
AGENTS.md

# Static copy of the generated OpenAPI spec, written by build-openapi.ps1 so the
# in-app Swagger UI can read it without going through the API. Generated, not authored.
frontend/public/openapi.json


node_modules/
