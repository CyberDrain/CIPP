{"id":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_maxrescanintervalinseconds","displayName":"Max Rescan Interval In Seconds (Windows Insiders only)","description":"Maximum time (in seconds) from the point that no connection could be established using the permissible eSIM profiles on the device to the start of the next round of network discovery attempts. A smaller interval increases network discovery frequency and can decrease battery life significantly. A value of 0 means that the device is to pick a reasonable interval per its own discretion.\r\n This setting is only available to Windows Insiders","helpText":"","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/WirelessNetworkPreference-csp/"],"categoryId":"0d9ee4f5-7d6b-41fd-9089-b0886f7ff944","categoryName":"Wireless Network Preference","options":null,"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","valueDefinition":{"@odata.type":"#microsoft.graph.deviceManagementConfigurationIntegerSettingValueDefinition","maximumValue":360,"minimumValue":0},"defaultOptionId":null,"applicability":{"@odata.type":"#microsoft.graph.deviceManagementConfigurationWindowsSettingApplicability","description":null,"platform":"windows10","deviceMode":"none","technologies":"mdm","configurationServiceProviderVersion":"1.0","maximumSupportedVersion":null,"minimumSupportedVersion":"10.0.25272","windowsSkus":["windowsEnterprise","windowsProfessional","windowsHome","windowsEducation","holographicForBusiness","windowsMultiSession","iotEnterprise","windowsCloudN","windows11SE","iotEnterpriseSEval","windowsCPC"],"requiresAzureAd":false,"requiredAzureAdTrustType":"none"},"accessTypes":"get,replace","settingUsage":"configuration","visibility":"settingsCatalog,template","rootDefinitionId":"vendor_msft_wirelessnetworkpreference_parameters_cellularparameters_maxrescanintervalinseconds","childIds":null,"minimumCount":null,"maximumCount":null,"keywords":["Max Rescan Interv