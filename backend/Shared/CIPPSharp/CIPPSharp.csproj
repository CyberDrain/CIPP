<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CIPPSharp</AssemblyName>
    <RootNamespace>CIPP</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- No deps.json is generated (GenerateDependencyFile=false), so NuGet runtime assemblies must be
         copied physically next to CIPPSharp.dll for the PowerShell host to resolve them by same-dir probing. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-only: ExcludeAssets="runtime" keeps the System.Management.Automation facade out of bin\
         (PowerShell supplies the real assembly at runtime) while still compiling against its types. -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Server-side PDF renderer. MIT, zero third-party deps: only OfficeIMO.Pdf.dll + OfficeIMO.Core.dll land in bin\.
         INTERIM: pinned to a locally patched OfficeIMO.Pdf 3.4.0 build that adds PdfTableStyle.CornerRadius /
         PdfPanelStyle.CornerRadius (rounded callout boxes and stat cards). Replace both References below with
           <PackageReference Include="OfficeIMO.Pdf" Version="<release with CornerRadius>" />
         once the change is published upstream (EvotecIT/OfficeIMO), and delete backend/Shared/CIPPSharp/lib. -->
    <Reference Include="OfficeIMO.Pdf">
      <HintPath>lib\OfficeIMO.Pdf.dll</HintPath>
    </Reference>
    <Reference Include="OfficeIMO.Core">
      <HintPath>lib\OfficeIMO.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
