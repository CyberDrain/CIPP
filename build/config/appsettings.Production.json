{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "App": {
    "Name": "CIPP",
    "ReadinessMode": "HttpReady",
    "KestrelTimeoutSeconds": 660,
    "FileLogging": {
      "LogLevel": "Information"
    },
    "Setup": {
      "Enabled": true,
      "AuthAppDisplayName": "CIPP-SSO",
      "UnauthenticatedClientAction": "RedirectToLoginPage",
      "ExcludedPaths": [
        "/api/PublicPing",
        "/api/publicping",
        "/api/PublicWebhooks",
        "/API/PublicWebhooks",
        "/api/publicwebhooks",
        "/api/PublicPhishingCheck",
        "/API/PublicPhishingCheck",
        "/api/PublicMcpRegister",
        "/API/PublicMcpRegister",
        "/api/publicmcpregister",
        "/api/setup/*",
        "/authredirect",
        "/LogoutRedirect",
        "/404",
        "/_next/static/*",
        "/assets/*",
        "/favicon.ico",
        "/apple-touch-icon.png",
        "/robots.txt",
        "/manifest.json",
        "/version.json",
        "/openapi.json",
        "/sw.js",
        "/.well-known/oauth-protected-resource",
        "/.well-known/oauth-protected-resource/*",
        "/.well-known/oauth-authorization-server",
        "/.well-known/oauth-authorization-server/*",
        "/.well-known/openid-configuration",
        "/.well-known/openid-configuration/*"
      ],
      "KeyVaultName": "auto"
    },
    "Worker": {
      "HttpPoolSize": 6,
      "BgPoolSize": 8,
      "SkuProfiles": [
        { "SkuEnv": "WEBSITE_SKU", "Sku": "Basic", "Cpu": 1, "HttpPoolSize": 2, "BgPoolSize": 2, "GCHeapHardLimitMB": 1536 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "Basic", "Cpu": 2, "HttpPoolSize": 6, "BgPoolSize": 8, "GCHeapHardLimitMB": 3072 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "Basic", "Cpu": 4, "HttpPoolSize": 8, "BgPoolSize": 12, "GCHeapHardLimitMB": 6656 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "PremiumV3", "Cpu": 1, "HttpPoolSize": 6, "BgPoolSize": 8, "GCHeapHardLimitMB": 3584 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "PremiumV3", "Cpu": 2, "HttpPoolSize": 8, "BgPoolSize": 12, "GCHeapHardLimitMB": 7680 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "PremiumV3", "Cpu": 4, "HttpPoolSize": 12, "BgPoolSize": 16, "GCHeapHardLimitMB": 15360 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "PremiumV3", "Cpu": 8, "HttpPoolSize": 16, "BgPoolSize": 24, "GCHeapHardLimitMB": 30720 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "PremiumV4", "Cpu": 1, "HttpPoolSize": 6, "BgPoolSize": 8, "GCHeapHardLimitMB": 3584 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "PremiumV4", "Cpu": 2, "HttpPoolSize": 8, "BgPoolSize": 12, "GCHeapHardLimitMB": 7680 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "PremiumV4", "Cpu": 4, "HttpPoolSize": 12, "BgPoolSize": 16, "GCHeapHardLimitMB": 15360 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "PremiumV4", "Cpu": 8, "HttpPoolSize": 16, "BgPoolSize": 24, "GCHeapHardLimitMB": 30720 }
      ],
      "SkuProfilesAltEnv": "CIPP_HOSTED",
      "SkuProfilesAlt": [
        { "SkuEnv": "WEBSITE_SKU", "Sku": "Basic", "Cpu": 1, "HttpPoolSize": 2, "BgPoolSize": 2, "GCHeapHardLimitMB": 1536 },
        { "SkuEnv": "WEBSITE_SKU", "Sku": "Basic", "Cpu": 4, "HttpPoolSize": 8, "BgPoolSize": 12, "GCHeapHardLimitMB": 6656 },
        { "SkuEnv": "", "HttpPoolSize": 6, "BgPoolSize": 8, "GCHeapHardLimitMB": 3072 }
      ],
      "HttpTimeoutSeconds": 600,
      "BgTimeoutSeconds": 1200,
      "HttpQueueTimeoutSeconds": 60,
      "RecycleAfterInvocations": 1000,
      "RootPathVars": [
        "CIPPRootPath",
        "CIPPRoot"
      ],
      "EnvVars": {
        "CIPPNG": "true",
        "CRAFT_ALLOWED_MODULES": "CIPPCore,CIPPStandards,CIPPAlerts,CIPPTests,CIPPDB,CippExtensions,DNSHealth,CIPPActivityTriggers"
      },
      "WarmupMode": "AfterReady",
      "WarmupScripts": [
        "Initialize-CIPPTables",
        "Initialize-CIPPAuth",
        "Initialize-CIPPTimezone",
        "Update-CIPPInstanceHostname",
        "Update-CIPPVersionHistory",
        "Write-CIPPInstanceBootMarker",
        "Update-CIPPPartnerWebhookUrl",
        "if ($env:ApplicationID) { $null = Get-Tenants -IncludeErrors }"
      ],
      "SharedAssemblies": [],
      "ModuleInjections": [
        {
          "Module": "CIPPCore",
          "Variable": "classictoken",
          "CacheKey": "ClassicTokenCache"
        },
        {
          "Module": "CIPPCore",
          "Variable": "CIPPEnsuredTables",
          "CacheKey": "CIPPTableCache"
        }
      ],
      "PostInitScripts": [],
      "HttpModules": [
        "CIPPCore",
        "CIPPHTTP",
        "AzBobbyTables"
      ],
      "BgModules": [
        "CIPPCore",
        "CIPPActivityTriggers",
        "AzBobbyTables"
      ],
      "JsonPreloads": [
        {
          "File": "Config/function-permissions.json",
          "Variable": "CIPPFunctionPermissions",
          "Scope": "global",
          "AsHashtable": true
        },
        {
          "File": "Config/cipp-roles.json",
          "Variable": "CIPPBaseRoles",
          "Scope": "global",
          "AsHashtable": false
        }
      ]
    },
    "Auth": {
      "UserTableName": "allowedUsers",
      "AllowAllTenantUsers": true,
      "MeEndpointFunction": "me",
      "MeEndpointHandler": "New-CippCoreRequest"
    },
    "Scheduler": {
      "ConfigFile": "Config/CIPPTimers.json",
      "CheckIntervalSeconds": 30,
      "ApplyTZOffset": false,
      "Timezone": ""
    },
    "Orchestrator": {
      "TablePrefix": "CippOrchestrator"
    },
    "Cache": {
      "MaxEntries": 1000,
      "DefaultTtlSeconds": 600,
      "InvalidateParam": "InvalidateCIPPCache",
      "ScopeParam": "tenantFilter",
      "EndpointTtl": {},
      "ExcludedEndpoints": [],
      "RequiredParam": "tenantFilter",
      "ExcludedParamValues": [
        "AllTenants"
      ]
    },
    "Scripts": {
      "HttpModules": [
        "CIPPHTTP"
      ],
      "HttpHandler": "New-CippCoreRequest",
      "BackgroundScriptDirs": [
        "Modules/CIPPCore/Public/Entrypoints/Timer Functions",
        "Modules/CIPPCore/Public/Entrypoints/Orchestrator Functions"
      ],
      "PermissionExtraction": {
        "Enabled": true,
        "Modules": [
          "CIPPHTTP"
        ],
        "OutputFile": "Config/function-permissions.json"
      }
    },
    "RateLimit": {
      "PermitPerWindow": 100,
      "Egress": {
        "BytesPerDay": 1073741824,
        "FlushSeconds": 60
      }
    }
  }
}
