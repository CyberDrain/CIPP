{"id":"com.apple.managedclient.preferences_newtabpagecompanylogobackplatecolor","displayName":"Set the company logo backplate color on the new tab page.","description":"By default, the new tab page sets the company logo backplate color to the neutralStrokeActive (#cecece) constant.\n\nYou can configure this policy with a color hex code to change the company logo backplate color on the new tab page.\n\nIf this policy is not configured, the default neutralStrokeActive (#cecece) color will be used as the backplate color.","helpText":null,"infoUrls":["https://docs.microsoft.com/deployedge/microsoft-edge-policies#newtabpagecompanylogobackplatecolor"],"categoryId":"9d14bbed-327d-4c38-ac02-6b916909bdd9","categoryName":"Microsoft Edge","options":null,"@odata.type":"#microsoft.graph.deviceManagementConfigurationSimpleSettingDefinition","valueDefinition":{"@odata.type":"#microsoft.graph.deviceManagementConfigurationStringSettingValueDefinition","format":"none","inputValidationSchema":null,"maximumLength":1032,"minimumLength":0,"isSecret":false,"fileTypes":[]},"defaultOptionId":null,"applicability":{"description":null,"platform":"macOS","deviceMode":"none","technologies":"mdm,appleRemoteManagement"},"accessTypes":"none","settingUsage":"configuration","visibility":"settingsCatalog,template","rootDefinitionId":"com.apple.managedclient.preferences_newtabpagecompanylogobackplatecolor","childIds":null,"minimumCount":null,"maximumCount":null,"keywords":["Microsoft Edge"],"dependentOn":[],"dependedOnBy":[]}