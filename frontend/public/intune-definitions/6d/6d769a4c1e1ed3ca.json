{"id":"com.apple.networkusagerules_simrules_item_wifiassistpolicy","displayName":"Wi Fi Assist Policy","description":"The Wi-Fi Assist policy to apply to the SIM cards specified in the ICCIDs. See About Wi-Fi Assist <https://support.apple.com/en-us/HT205296> to learn more.\n* '2': Use the default system policy for the specified SIM card(s).\n* '3': Make Wi-Fi Assist switch more aggressively from a poor Wi-Fi connection to cellular data for the specified SIM card(s). This setting may increase cellular data use and may impact battery life.","helpText":null,"infoUrls":[],"categoryId":"06a85f5b-2614-4467-91cf-4a64d0c9326f","categoryName":"Network Usage Rules","options":[{"id":"com.apple.networkusagerules_simrules_item_wifiassistpolicy_0","displayName":"2","description":null,"helpText":null,"optionValue":{"@odata.type":"#microsoft.graph.deviceManagementConfigurationIntegerSettingValue","settingValueTemplateReference":null,"value":2},"dependentOn":[{"dependentOn":"com.apple.networkusagerules_simrules","parentSettingId":"com.apple.networkusagerules_simrules"}],"dependedOnBy":[]},{"id":"com.apple.networkusagerules_simrules_item_wifiassistpolicy_1","displayName":"3","description":null,"helpText":null,"optionValue":{"@odata.type":"#microsoft.graph.deviceManagementConfigurationIntegerSettingValue","settingValueTemplateReference":null,"value":3},"dependentOn":[{"dependentOn":"com.apple.networkusagerules_simrules","parentSettingId":"com.apple.networkusagerules_simrules"}],"dependedOnBy":[]}],"@odata.type":"#microsoft.graph.deviceManagementConfigurationChoiceSettingDefinition","valueDefinition":null,"defaultOptionId":"com.apple.networkusagerules_simrules_item_wifiassistpolicy_0","applicability":{"description":null,"platform":"iOS","deviceMode":"none","technologies":"mdm,appleRemoteManagement"},"accessTypes":"none","settingUsage":"configuration","visibility":"settingsCatalog,template","rootDefinitionId":"com.apple.networkusagerules_com.apple.networkusagerules","childIds":null,"min